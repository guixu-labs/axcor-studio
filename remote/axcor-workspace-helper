#!/usr/bin/env python3
"""Serve the Axcor workspace file protocol over an authenticated SSH session."""

import ctypes
import errno
import fcntl
import hashlib
import json
import os
import select
import secrets
import shutil
import socket
import subprocess
import stat
import struct
import sys
import threading
from contextlib import contextmanager

MAX_FILE = 2 * 1024 * 1024
MAX_LINE = 16 * 1024 * 1024
SKIP = {'node_modules', 'out', 'dist', '__pycache__'}
DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW

IN_CONTENT = 0x02 | 0x04 | 0x08  # MODIFY, ATTRIB, CLOSE_WRITE
IN_ENTRIES = 0x40 | 0x80 | 0x100 | 0x200  # MOVED_FROM, MOVED_TO, CREATE, DELETE
IN_SELF = 0x400 | 0x800  # DELETE_SELF, MOVE_SELF
IN_OVERFLOW = 0x4000
IN_IGNORED = 0x8000
IN_ISDIR = 0x40000000
INOTIFY_EVENT = struct.Struct('iIII')


def components(path, absolute=False):
    if not isinstance(path, str) or path.startswith('/') != absolute:
        raise ValueError('Invalid workspace path')
    parts = (path[1:] if absolute else path).split('/')
    if any(part in ('', '.', '..') or '\0' in part for part in parts):
        raise ValueError('Invalid workspace path')
    return parts


@contextmanager
def directory(start, parts):
    fd = os.dup(start)
    try:
        for part in parts:
            child = os.open(part, DIR_FLAGS, dir_fd=fd)
            os.close(fd)
            fd = child
        yield fd
    finally:
        os.close(fd)


def read_file(parent, name):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
    with os.fdopen(fd, 'rb') as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode):
            raise ValueError('Only regular files are supported')
        data = source.read(MAX_FILE + 1)
        if len(data) > MAX_FILE:
            raise ValueError('File exceeds the 2 MiB editing limit')
        return data, info


def version(data, info):
    return hashlib.sha256(data + str((info.st_dev, info.st_ino, info.st_mtime_ns, info.st_ctime_ns)).encode()).hexdigest()


def save_file(parent, name, content, expected):
    data = content.encode('utf-8')
    if len(data) > MAX_FILE:
        raise ValueError('File exceeds the 2 MiB editing limit')
    # Serialize writes by Axcor clients in this directory. Check again after
    # writing the temporary file to detect intervening external edits.
    fcntl.flock(parent, fcntl.LOCK_EX)
    temporary = None
    try:
        old, info = read_file(parent, name)
        if version(old, info) != expected:
            raise ValueError('File changed on the server. Reload before saving.')
        # Replacing a directory entry alone would bypass the file's write permissions.
        original = os.open(name, os.O_WRONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
        try:
            if not os.path.samestat(info, os.fstat(original)):
                raise ValueError('File changed on the server. Reload before saving.')
        finally:
            os.close(original)
        candidate = '.axcor-save-' + secrets.token_hex(16)
        fd = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent)
        temporary = candidate
        with os.fdopen(fd, 'wb') as output:
            created = os.fstat(output.fileno())
            if (created.st_uid, created.st_gid) != (info.st_uid, info.st_gid):
                os.fchown(output.fileno(), info.st_uid, info.st_gid)
            os.fchmod(output.fileno(), stat.S_IMODE(info.st_mode) & 0o777)
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        old, info = read_file(parent, name)
        if version(old, info) != expected:
            raise ValueError('File changed on the server. Reload before saving.')
        os.replace(temporary, name, src_dir_fd=parent, dst_dir_fd=parent)
        temporary = None
        os.fsync(parent)
        written = os.stat(name, dir_fd=parent, follow_symlinks=False)
        return {'content': content, 'version': version(data, written)}
    finally:
        if temporary is not None:
            os.unlink(temporary, dir_fd=parent)
        fcntl.flock(parent, fcntl.LOCK_UN)


def list_directory(fd, prefix):
    nodes = []
    with os.scandir(fd) as entries:
        for entry in entries:
            if entry.is_dir(follow_symlinks=False) and not entry.name.startswith('.') and entry.name not in SKIP:
                kind = 'dir'
            elif entry.is_file(follow_symlinks=False) and not entry.name.startswith('.axcor-save-'):
                kind = 'file'
            else:
                continue
            nodes.append({'name': entry.name, 'path': prefix + entry.name, 'type': kind})
    return sorted(nodes, key=lambda node: (node['type'], node['name'].casefold()))


class WorkspaceWatcher:
    def __init__(self, emit):
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.fd = self.libc.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
        if self.fd < 0:
            error = ctypes.get_errno()
            raise OSError(error, os.strerror(error))
        self.paths = {}
        self.lock = threading.Lock()
        self.stopped = threading.Event()
        self.thread = threading.Thread(target=self.listen, args=(emit,), daemon=True)
        self.thread.start()

    def list(self, fd, prefix):
        with self.lock:
            # The directory has already been opened with O_NOFOLLOW.
            wd = self.libc.inotify_add_watch(self.fd, os.fsencode(f'/proc/self/fd/{fd}'),
                                             IN_CONTENT | IN_ENTRIES | IN_SELF)
            if wd >= 0:
                self.paths[wd] = prefix
            nodes = list_directory(fd, prefix)
            children = {node['path'] + '/' for node in nodes if node['type'] == 'dir'}
            for descriptor, watched in list(self.paths.items()):
                if descriptor == wd or not watched.startswith(prefix):
                    continue
                child = watched[len(prefix):].split('/', 1)[0]
                if not child or prefix + child + '/' not in children:
                    self.libc.inotify_rm_watch(self.fd, descriptor)
                    del self.paths[descriptor]
        return nodes

    def listen(self, emit):
        while not self.stopped.is_set():
            if not select.select([self.fd], [], [], 0.2)[0]:
                continue
            with self.lock:
                data = os.read(self.fd, 65536)
                offset = 0
                files = set()
                tree = False
                all_files = False
                while offset < len(data):
                    wd, mask, _, length = INOTIFY_EVENT.unpack_from(data, offset)
                    offset += INOTIFY_EVENT.size
                    name = os.fsdecode(data[offset:offset + length].split(b'\0', 1)[0])
                    offset += length
                    if mask & IN_OVERFLOW:
                        tree = all_files = True
                    elif mask & IN_IGNORED:
                        self.paths.pop(wd, None)
                    elif wd not in self.paths or name.startswith('.axcor-save-'):
                        continue
                    elif mask & IN_SELF or mask & IN_ISDIR and mask & IN_ENTRIES:
                        if not name or (not name.startswith('.') and name not in SKIP):
                            tree = all_files = True
                    elif name and not mask & IN_ISDIR:
                        files.add(self.paths[wd] + name)
                        tree |= bool(mask & IN_ENTRIES)
            if tree or files:
                emit({'event': 'files-changed', 'tree': tree, 'paths': None if all_files else sorted(files)})

    def close(self):
        self.stopped.set()
        self.thread.join(timeout=0.3)
        os.close(self.fd)


def remote_service(action, port):
    service, operation = action.split('-', 1)
    executable_name = 'context-insight' if service == 'insight' else 'workflow-controller'
    if type(port) is not int or not 1 <= port <= 65535:
        raise ValueError('Invalid service port')
    home = os.path.expanduser('~')
    state = os.path.join(home, '.local', 'state', 'axcor-studio')
    os.makedirs(state, mode=0o700, exist_ok=True)
    lock_path = os.path.join(state, f'{service}-{port}.lock')
    lock = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 'starting'
        if operation == 'state':
            return 'stopped'
        # A managed or externally started instance can win the race after the
        # desktop probe. Let the desktop check it without launching a duplicate.
        with socket.socket() as listener:
            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                listener.bind(('127.0.0.1', port))
            except OSError as error:
                if error.errno == errno.EADDRINUSE:
                    return 'occupied'
                raise
        env = dict(os.environ)
        env['PATH'] = os.pathsep.join((env.get('PATH', os.defpath), os.path.join(home, '.local', 'bin')))
        executable = shutil.which(executable_name, path=env['PATH'])
        if not executable:
            return 'missing-command'
        command = [executable]
        if service == 'insight':
            env['CONTEXT_INSIGHT_PORT'] = str(port)
            env['CONTEXT_NO_BROWSER'] = '1'
        else:
            command += ['web', '--host', '127.0.0.1', '--port', str(port), '--no-open']
        log_path = os.path.join(state, f'{service}-{port}.log')
        log = os.open(log_path, os.O_CREAT | os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW, 0o600)
        with os.fdopen(log, 'ab') as output:
            # The launcher inherits the lock. Closing the SSH session leaves the
            # service and its startup lock alive until the launcher exits.
            subprocess.Popen(command, cwd=home, env=env, stdin=subprocess.DEVNULL,
                             stdout=output, stderr=output, start_new_session=True, pass_fds=(lock,))
        return 'starting'
    finally:
        os.close(lock)


def dispatch(root, root_path, request):
    action = request['action']
    if action in ('insight-start', 'insight-state', 'controller-start', 'controller-state'):
        return remote_service(action, request['port'])
    if action in ('open', 'root'):
        return root_path
    parts = components(request['path'])
    with directory(root, parts[:-1]) as parent:
        name = parts[-1]
        if action == 'read':
            data, info = read_file(parent, name)
            return {'content': data.decode('utf-8'), 'version': version(data, info)}
        if action == 'write':
            return save_file(parent, name, request['content'], request['version'])
        if action == 'program':
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
            try:
                if not stat.S_ISREG(os.fstat(fd).st_mode):
                    raise ValueError('The workflow must be a regular file')
                return root_path + '/' + '/'.join(parts)
            finally:
                os.close(fd)
    raise ValueError('Unknown workspace operation')


def serve():
    root = None
    root_path = None
    slash = os.open('/', DIR_FLAGS)
    watcher = None
    output = threading.Lock()

    def emit(message):
        with output:
            print(json.dumps(message, ensure_ascii=True), flush=True)

    try:
        while line := sys.stdin.buffer.readline(MAX_LINE + 1):
            if len(line) > MAX_LINE:
                raise ValueError('Workspace request is too large')
            response = {}
            try:
                request = json.loads(line)
                if root is None:
                    if request['action'] != 'open':
                        raise ValueError('Open a workspace first')
                    root_path = request['root']
                    with directory(slash, components(root_path, absolute=True)) as opened:
                        root = os.dup(opened)
                # Detect replacement of the selected directory before using it.
                with directory(slash, components(root_path, absolute=True)) as current:
                    if not os.path.samestat(os.fstat(root), os.fstat(current)):
                        raise ValueError('Workspace directory changed. Reconnect.')
                if request['action'] == 'list':
                    if watcher is None and sys.platform == 'linux':
                        try:
                            watcher = WorkspaceWatcher(emit)
                        except OSError:
                            pass  # The manual sync remains available.
                    path = request.get('path', '')
                    parts = components(path) if path != '' else []
                    prefix = path + '/' if parts else ''
                    with directory(root, parts) as fd:
                        response['value'] = watcher.list(fd, prefix) if watcher else list_directory(fd, prefix)
                else:
                    response['value'] = dispatch(root, root_path, request)
            except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
                response['error'] = ('Symbolic links are not allowed' if isinstance(error, OSError)
                                     and error.errno == errno.ELOOP else str(error))
            emit(response)
    finally:
        if watcher is not None:
            watcher.close()
        if root is not None:
            os.close(root)
        os.close(slash)


if __name__ == '__main__':
    if sys.argv[1:] != ['--stdio']:
        sys.exit('Usage: axcor-workspace-helper --stdio')
    serve()
